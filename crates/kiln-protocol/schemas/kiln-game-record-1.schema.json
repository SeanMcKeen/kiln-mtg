{
  "$defs": {
    "CardFact": {
      "additionalProperties": false,
      "description": "One card its owner saw (commanders and tokens aren't tracked).",
      "properties": {
        "cast": {
          "description": "The turn it was first cast or played.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "seen": {
          "description": "The turn it first reached its owner's hand; 0 = the opening hand.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "seen"
      ],
      "type": "object"
    },
    "Elimination": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "description": "`life`, `commander_damage`, `decking`, `poison`, `concession` or `effect_loss`.",
          "type": "string"
        },
        "seat": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "turn": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "seat",
        "turn",
        "reason"
      ],
      "type": "object"
    },
    "Outcome": {
      "oneOf": [
        {
          "enum": [
            "win",
            "draw"
          ],
          "type": "string"
        },
        {
          "const": "capped",
          "description": "Stopped by a harness limit; excluded from win-rate denominators.",
          "type": "string"
        },
        {
          "const": "not_played",
          "description": "No game was played (`mode: opening_hands`).",
          "type": "string"
        }
      ]
    },
    "SeatCards": {
      "additionalProperties": false,
      "properties": {
        "cards": {
          "items": {
            "$ref": "#/$defs/CardFact"
          },
          "type": "array"
        },
        "seat": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "seat",
        "cards"
      ],
      "type": "object"
    },
    "SeatInteraction": {
      "additionalProperties": false,
      "properties": {
        "countered": {
          "description": "Its spells that were countered.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "counterspells": {
          "description": "Spells cast that counter spells or abilities.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "targeted_opponents": {
          "description": "Times its spells and abilities targeted a permanent another player controlled.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "counterspells",
        "countered",
        "targeted_opponents"
      ],
      "type": "object"
    },
    "SeatMana": {
      "additionalProperties": false,
      "properties": {
        "early_turns": {
          "description": "Of its first five turns, how many it took.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "lands_played": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mana_produced": {
          "description": "Mana added to its pool (each unit).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "missed_land_drops": {
          "description": "Of those, turns with no land played.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "lands_played",
        "mana_produced",
        "early_turns",
        "missed_land_drops"
      ],
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "description": "Microseconds of wall-clock time.",
      "properties": {
        "policy_us": {
          "description": "Time inside each seat's policy.",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "total_us": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total_us",
        "policy_us"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capped": {
      "description": "Why a capped game stopped: `max_turns`, `max_decisions` or `max_wall_ms`.",
      "type": [
        "string",
        "null"
      ]
    },
    "cards": {
      "description": "Per-card facts for tracked decks (`metrics.per_card`).",
      "items": {
        "$ref": "#/$defs/SeatCards"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "config": {
      "description": "`base`, or the A/B variant this game belongs to.",
      "type": "string"
    },
    "decision_kinds": {
      "additionalProperties": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "description": "Decision counts by kind (`metrics.decision_stats`).",
      "type": [
        "object",
        "null"
      ]
    },
    "decisions": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "eliminations": {
      "description": "Players in the order they left the game.",
      "items": {
        "$ref": "#/$defs/Elimination"
      },
      "type": "array"
    },
    "hand": {
      "description": "`mode: opening_hands`: the hand seat 1 kept.",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "index": {
      "description": "The game's index; configurations share indices and seeds (paired runs).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "interaction": {
      "description": "Per seat (`metrics.interaction`).",
      "items": {
        "$ref": "#/$defs/SeatInteraction"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "mana": {
      "description": "Per seat (`metrics.mana`).",
      "items": {
        "$ref": "#/$defs/SeatMana"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "mulligans": {
      "description": "Mulligans taken, per seat.",
      "items": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "policy_errors": {
      "description": "The first playbook runtime errors (\"seat 2: priority: …\").",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "policy_stats": {
      "description": "Per seat: which policy component answered, playbook tags and errors.",
      "items": {
        "additionalProperties": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": "object"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "seats": {
      "description": "The deck id in each seat, in turn order (seat 1 plays first).\nGoldfish opponents are `opponent`.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "seed": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "timing": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timing"
        },
        {
          "type": "null"
        }
      ],
      "description": "Wall-clock time (`metrics.timing`): not deterministic."
    },
    "turns": {
      "description": "Turn number when the game ended.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "win_type": {
      "description": "How the game was won (M7 plan S11).",
      "type": [
        "string",
        "null"
      ]
    },
    "winner": {
      "description": "The winning seat (0-based).",
      "format": "uint",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "config",
    "index",
    "seed",
    "seats",
    "outcome",
    "turns",
    "eliminations",
    "mulligans",
    "decisions"
  ],
  "title": "GameRecord",
  "type": "object"
}
