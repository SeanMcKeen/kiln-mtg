          "type": "number"
        },
        "difference_ci95": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "paired_games": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "variant": {
          "type": "string"
        },
        "variant_rate": {
          "$ref": "#/$defs/Rate"
        }
      },
      "required": [
        "variant",
        "base_deck",
        "paired_games",
        "base",
        "variant_rate",
        "difference",
        "difference_ci95"
      ],
      "type": "object"
    },
    "ConciseWinRate": {
      "additionalProperties": false,
      "properties": {
        "by_seat": {
          "items": {
            "format": "double",
            "type": "number"
          },
