        "win_rate",
        "ci95",
        "by_seat"
      ],
      "type": "object"
    },
    "OpeningHandStats": {
      "additionalProperties": false,
      "properties": {
        "deck": {
          "type": "string"
        },
        "features": {
          "additionalProperties": {
            "$ref": "#/$defs/Rate"
          },
          "description": "Feature name → share of kept hands with at least one of its cards.",
          "type": "object"
        },
        "hand_sizes": {
          "default": [],
          "description": "The hand size kept after 0, 1, 2, … mulligans (the first is free in the\n4-player pod these hands are dealt in, CR 103.5c).",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "hands": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kept_at": {
          "description": "Share of hands kept after 0, 1, 2, … mulligans (index = mulligans taken).",
          "items": {
            "$ref": "#/$defs/Rate"
          },
          "type": "array"
        }
      },
      "required": [
        "deck",
        "hands",
        "kept_at",
        "features"
      ],
      "type": "object"
    },
    "Rate": {
      "additionalProperties": false,
      "description": "A rate with its 95% Wilson interval.",
      "properties": {
        "ci95": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "k": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "n": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rate": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "n",
        "k",
        "rate",
        "ci95"
      ],
      "type": "object"
    },
    "Versions": {
      "additionalProperties": false,
      "properties": {
        "card_db": {
          "type": "string"
        },
        "cr": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "spec_hash": {
          "type": "string"
        }
      },
      "required": [
        "engine",
        "card_db",
        "cr",
        "spec_hash"
      ],
      "type": "object"
    }
